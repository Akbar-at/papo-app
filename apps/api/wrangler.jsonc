{
  "name": "papo-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "papo-app-private-photos-dev"
    }
  ],
  "triggers": {
    "crons": []
  },
  "vars": {
    "APP_ENV": "development",
    "MAX_MEDIA_BYTES": "20000000"
  }
}
